{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=defaultdb;Username=${DB_USER};Password=${DB_PASS};SSL Mode=Require;Trust Server Certificate=true"
  }
}
